# Authentication (OBLIGATOIRE — pas de fallback en dev)
JWT_SECRET="changez-moi-en-production-avec-une-vraie-cle-aleatoire"
JWT_EXPIRES_IN="1d"

# App URL (utilisé pour les liens, redirections, etc.)
NEXT_PUBLIC_APP_URL="http://localhost:3001"

# CORS (liste des origines autorisées, séparées par des virgules)
CORS_ORIGINS="http://localhost:4200,http://localhost:3000"

# Storage (Cloudinary)
CLOUDINARY_CLOUD_NAME="votre-cloud-name"
CLOUDINARY_API_KEY="votre-api-key"
CLOUDINARY_API_SECRET="votre-api-secret"

# Web Push (VAPID) — générez vos clés avec : npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY="votre-cle-publique-vapid"
VAPID_PRIVATE_KEY="votre-cle-privee-vapid"
VAPID_SUBJECT="mailto:contact@jammakxeewal.sn"

# Sentry (optionnel — laissez vide si vous n'utilisez pas Sentry)
SENTRY_DSN=""
VITE_SENTRY_AUTH_TOKEN=""

# Email de contact public (optionnel)
PUBLIC_CONTACT_EMAIL="contact@jammakxeewal.sn"

# URL publique du site (pour les icônes push, etc.)
PUBLIC_SITE_URL="https://jammakxeewal.sn"
