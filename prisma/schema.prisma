generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model AdminUser {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      String   @default("ADMIN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Adherent {
  id            String   @id @default(uuid())
  prenom        String
  nom           String
  telephone     String   @unique
  quartier      String
  profession    String?
  competences   String?
  disponibilite String?
  statut        String   @default("NOUVEAU")
  createdAt     DateTime @default(now())
  carteRectoUrl String?
  carteVersoUrl String?

  poleId        String?
  pole          Pole?    @relation(fields: [poleId], references: [id])

  @@index([telephone])
  @@index([quartier])
  @@index([statut])
  @@index([createdAt])
  @@index([poleId])
}

model Personne {
  id        String   @id @default(uuid())
  telephone String   @unique
  nom       String?
  besoins   Besoin[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([telephone])
}

model Besoin {
  id          String   @id @default(uuid())
  description String
  quartier    String
  photoUrl    String?
  contact     String?
  urgence     String   @default("MOYENNE")
  statut      String   @default("EN_ATTENTE")
  createdAt   DateTime @default(now())
  categorie   String?
  vocalUrl    String?

  personneId  String?
  personne    Personne? @relation(fields: [personneId], references: [id])

  @@index([contact])
  @@index([quartier])
  @@index([statut])
  @@index([urgence])
  @@index([createdAt])
  @@index([personneId])
}

model Idee {
  id          String   @id @default(uuid())
  titre       String
  description String
  auteur      String?
  pole        String?
  votes       Int      @default(0)
  statut      String   @default("NOUVELLE")
  createdAt   DateTime @default(now())
  categorie   String?

  @@index([statut])
  @@index([votes])
  @@index([createdAt])
}

model Commission {
  id            String   @id @default(uuid())
  nom           String
  responsable   String?
  membresCount  Int      @default(0)
  statut        String   @default("ACTIVE")
  createdAt     DateTime @default(now())
  dernierProjet String?
  reunions      Int      @default(0)

  @@index([statut])
  @@index([createdAt])
}

model Sondage {
  id           String          @id @default(uuid())
  question     String
  participants Int             @default(0)
  statut       String          @default("ACTIF")
  createdAt    DateTime        @default(now())
  options      SondageOption[]

  @@index([statut])
  @@index([createdAt])
}

model SondageOption {
  id        String  @id @default(uuid())
  texte     String
  votes     Int     @default(0)
  sondageId String
  sondage   Sondage @relation(fields: [sondageId], references: [id], onDelete: Cascade)
}

model Activite {
  id          String   @id @default(uuid())
  titre       String
  description String?
  categorie   String
  date        DateTime
  typeMedia   String   @default("PHOTOS")
  mediaUrl    String?
  mediaCount  Int      @default(0)
  statut      String   @default("PUBLIE")
  createdAt   DateTime @default(now())
}

model CompteRendu {
  id        String   @id @default(uuid())
  titre     String
  lieu      String
  date      DateTime
  auteur    String
  contenu   String?
  statut    String   @default("BROUILLON")
  createdAt DateTime @default(now())
}

model Message {
  id        String   @id @default(uuid())
  nom       String
  email     String?
  telephone String?
  sujet     String
  contenu   String
  lu        Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([lu])
  @@index([createdAt])
  @@index([telephone])
}

model Settings {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model Editorial {
  id        String   @id @default(uuid())
  page      String   @unique
  content   String
  updatedAt DateTime @updatedAt
}

model Option {
  id        String   @id @default(uuid())
  type      String
  value     String
  label     String
  ordre     Int      @default(0)
  actif     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([type, value])
  @@index([type])
}

model Evenement {
  id          String   @id @default(uuid())
  titre       String
  description String?
  date        DateTime
  heureDebut  String?
  heureFin    String?
  lieu        String?
  categorie   String?  // Ex: "Causerie", "Rencontre", "Formation"
  imageUrl    String?
  statut      String   @default("A_VENIR") // A_VENIR, EN_COURS, TERMINE, ANNULE
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date])
  @@index([statut])
  @@index([categorie])
}

model PushSubscription {
  id        String   @id @default(uuid())
  endpoint  String   @unique
  keys      Json
  createdAt DateTime @default(now())
}

model Pole {
  id          String   @id @default(uuid())
  titre       String
  description String
  objectifs   String?  // JSON string array of objectives
  statut      String   @default("PUBLIE") // PUBLIE, BROUILLON
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  adherents   Adherent[]

  @@index([statut])
  @@index([createdAt])
}
