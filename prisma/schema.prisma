generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model AdminUser {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      String   @default("ADMIN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Adherent {
  id            String   @id @default(uuid())
  prenom        String
  nom           String
  telephone     String
  quartier      String
  profession    String?
  competences   String?
  disponibilite String?
  statut        String   @default("NOUVEAU")
  createdAt     DateTime @default(now())
  carteRectoUrl String?
  carteVersoUrl String?

  @@index([telephone])
  @@index([quartier])
  @@index([statut])
  @@index([createdAt])
}

model Besoin {
  id          String   @id @default(uuid())
  description String
  quartier    String
  photoUrl    String?
  contact     String?
  urgence     String   @default("MOYENNE")
  statut      String   @default("EN_ATTENTE")
  createdAt   DateTime @default(now())
  categorie   String?
  vocalUrl    String?

  @@index([contact])
  @@index([quartier])
  @@index([statut])
  @@index([urgence])
  @@index([createdAt])
}

model Idee {
  id          String   @id @default(uuid())
  titre       String
  description String
  auteur      String?
  pole        String?
  votes       Int      @default(0)
  statut      String   @default("NOUVELLE")
  createdAt   DateTime @default(now())
  categorie   String?

  @@index([statut])
  @@index([votes])
  @@index([createdAt])
}

model Commission {
  id            String   @id @default(uuid())
  nom           String
  responsable   String?
  membresCount  Int      @default(0)
  statut        String   @default("ACTIVE")
  createdAt     DateTime @default(now())
  dernierProjet String?
  reunions      Int      @default(0)

  @@index([statut])
  @@index([createdAt])
}

model Sondage {
  id           String          @id @default(uuid())
  question     String
  participants Int             @default(0)
  statut       String          @default("ACTIF")
  createdAt    DateTime        @default(now())
  options      SondageOption[]

  @@index([statut])
  @@index([createdAt])
}

model SondageOption {
  id        String  @id @default(uuid())
  texte     String
  votes     Int     @default(0)
  sondageId String
  sondage   Sondage @relation(fields: [sondageId], references: [id], onDelete: Cascade)
}

model Activite {
  id         String   @id @default(uuid())
  titre      String
  categorie  String
  date       DateTime
  typeMedia  String   @default("PHOTOS")
  mediaUrl   String?
  mediaCount Int      @default(0)
  statut     String   @default("BROUILLON")
  createdAt  DateTime @default(now())
}

model CompteRendu {
  id        String   @id @default(uuid())
  titre     String
  lieu      String
  date      DateTime
  auteur    String
  contenu   String?
  statut    String   @default("BROUILLON")
  createdAt DateTime @default(now())
}

model Message {
  id        String   @id @default(uuid())
  nom       String
  email     String?
  telephone String?
  sujet     String
  contenu   String
  lu        Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([lu])
  @@index([createdAt])
  @@index([telephone])
}

model Settings {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model Editorial {
  id        String   @id @default(uuid())
  page      String   @unique
  content   String
  updatedAt DateTime @updatedAt
}

model Option {
  id        String   @id @default(uuid())
  type      String
  value     String
  label     String
  ordre     Int      @default(0)
  actif     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([type, value])
  @@index([type])
}
