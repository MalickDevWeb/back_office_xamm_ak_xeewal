generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model AdminUser {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      String   @default("ADMIN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Adherent {
  id              String   @id @default(uuid())
  prenom          String
  nom             String
  telephone       String
  quartier        String
  localite        String?
  profession      String?
  competences     String?
  disponibilite   String?
  carteRectoUrl   String?
  carteVersoUrl   String?
  statut          String   @default("NOUVEAU") // NOUVEAU, ACTIF, SUSPENDU
  createdAt       DateTime @default(now())

  @@index([telephone])
  @@index([quartier])
  @@index([localite])
  @@index([statut])
  @@index([createdAt])
}

model Besoin {
  id           String   @id @default(uuid())
  description  String
  categorie    String?
  quartier     String
  localite     String?
  photoUrl     String?
  vocalUrl     String?  // URL Cloudinary du message vocal
  contact      String?
  urgence      String   @default("MOYENNE") // HAUTE, MOYENNE, BASSE
  statut       String   @default("EN_ATTENTE") // EN_ATTENTE, EN_COURS, RESOLU
  createdAt    DateTime @default(now())

  @@index([contact])
  @@index([quartier])
  @@index([localite])
  @@index([statut])
  @@index([urgence])
  @@index([createdAt])
}

model Idee {
  id           String   @id @default(uuid())
  titre        String
  description  String
  categorie    String?
  auteur       String?
  pole         String?
  votes        Int      @default(0)
  statut       String   @default("NOUVELLE") // NOUVELLE, A_LETUDE, VALIDEE, REJETEE
  createdAt    DateTime @default(now())

  @@index([statut])
  @@index([votes])
  @@index([createdAt])
}

model Commission {
  id           String   @id @default(uuid())
  nom          String
  responsable  String?
  membresCount Int      @default(0)
  reunions     Int      @default(0)
  dernierProjet String?
  statut       String   @default("ACTIVE")
  createdAt    DateTime @default(now())

  @@index([statut])
  @@index([createdAt])
}

model Sondage {
  id           String   @id @default(uuid())
  question     String
  participants Int      @default(0)
  statut       String   @default("ACTIF") // ACTIF, CLOTURE
  options      SondageOption[]
  createdAt    DateTime @default(now())

  @@index([statut])
  @@index([createdAt])
}

model SondageOption {
  id        String  @id @default(uuid())
  texte     String
  votes     Int     @default(0)
  sondageId String
  sondage   Sondage @relation(fields: [sondageId], references: [id], onDelete: Cascade)
}

model Activite {
  id        String   @id @default(uuid())
  titre     String
  categorie String
  date      DateTime
  typeMedia String   @default("PHOTOS") // PHOTOS, VIDEO
  mediaUrl  String?
  mediaCount Int     @default(0)
  statut    String   @default("BROUILLON") // BROUILLON, PUBLIE
  createdAt DateTime @default(now())
}

model CompteRendu {
  id        String   @id @default(uuid())
  titre     String
  lieu      String
  date      DateTime
  auteur    String
  contenu   String?  @db.Text
  statut    String   @default("BROUILLON") // BROUILLON, INTERNE, PUBLIE
  createdAt DateTime @default(now())
}

model Message {
  id        String   @id @default(uuid())
  nom       String
  email     String?
  telephone String?
  sujet     String
  contenu   String   @db.Text
  lu        Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([lu])
  @@index([createdAt])
  @@index([telephone])
}

model Settings {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

model Editorial {
  id        String   @id @default(uuid())
  page      String   @unique // "mouvement", "axes"
  content   String   @db.Text // JSON stringifié
  updatedAt DateTime @updatedAt
}

// Options dynamiques pour les selects (quartiers, axes, catégories, etc.)
model Option {
  id        String   @id @default(uuid())
  type      String   // "quartier", "axe", "categorie", "statut", "urgence", "pole"
  value     String   // Valeur stockée en base
  label     String   // Label affiché à l'utilisateur
  ordre     Int      @default(0)
  actif     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([type, value])
  @@index([type])
}
